# Normalise line endings so the LF/CRLF warning stops and checkouts are stable.
* text=auto eol=lf

# Windows-native script types keep CRLF in the working tree.
*.ps1   text eol=crlf
*.psd1  text eol=crlf
*.ahk   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touch these.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary

# ------------------------------------------------------------------------------
#  Git LFS: the offline installers under installers\ are large binaries, stored
#  via LFS so the main repo history stays small. Everything in installers\ is
#  LFS-tracked EXCEPT the README.
# ------------------------------------------------------------------------------
installers/**            filter=lfs diff=lfs merge=lfs -text
installers/README.md     !filter !diff !merge text eol=lf
installers/Win11Debloat/** !filter !diff !merge
