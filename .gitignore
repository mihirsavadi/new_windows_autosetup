# Run logs (one per run, timestamped)
setup_*.log

# The offline installers themselves ARE committed (via Git LFS - see .gitattributes).
# Only ignore the Win11Debloat copy that tasks\60-debloat.ps1 downloads at runtime.
installers/Win11Debloat/

# TestRun scratch (only ever created under %TEMP%, but just in case)
nwas-testrun-*/

# Per-machine state (startup baseline snapshot) - local, not shared
.state/
